use std::env;
use std::fs;
use crate::genesis::Genesis;

fn main() {
    let args: Vec<String> = env::args().collect();
    if args.len() != 2 {
        eprintln!("Usage: dump_genesis_hash <genesis.json>");
        std::process::exit(1);
    }
    let path = &args[1];
    let data = fs::read_to_string(path).expect("Cannot read genesis file");
    let genesis: Genesis = serde_json::from_str(&data).expect("Invalid genesis JSON");
    let hash = genesis.genesis_hash();
    println!("{}", hex::encode(hash));
}
