use serde::{Deserialize, Serialize};

/// 256-bit hash – used for block hashes, certificate IDs, etc.
pub type Hash256 = [u8; 32];

/// A proposal for the next block in the chain.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct BlockProposal {
    pub height: u64,
    pub block_hash: Hash256,
    pub proposer: Hash256,         // certificate id of the proposer
    pub round: u64,
    pub timestamp: u64,
}

/// A vote cast by a validator.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Vote {
    pub height: u64,
    pub block_hash: Hash256,
    pub voter: Hash256,            // certificate id of the voter
    pub round: u64,
    pub vote_type: VoteType,
    pub timestamp: u64,
}

#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
pub enum VoteType {
    Prevote,
    Precommit,
}

/// Quorum certificate proving a block has been committed.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct QuorumCertificate {
    pub height: u64,
    pub block_hash: Hash256,
    pub round: u64,
    // BLS aggregate signature – placeholder for now.
    pub aggregated_signature: Vec<u8>,
    // Bitmap of which validators signed.
    pub signers_bitmap: Vec<u8>,
}
