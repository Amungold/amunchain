+    pub end_height: u64,
+}
+
+/// Catchup response (from any peer with a store)
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct CatchupResponse {
+    pub records: Vec<FinalizedChainRecord>,
+}
